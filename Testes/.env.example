# Kenzie 0.9 - LOCAL inference by default
KENZIE_LOCAL_ENABLED=1
KENZIE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
KENZIE_LOCAL_MODEL=qwen2.5:1.5b
KENZIE_LOCAL_TEMPERATURE=0.7
KENZIE_LOCAL_MAX_TOKENS=900
KENZIE_LOCAL_TIMEOUT=90

# Independent component switches (1=enabled, 0=disabled)
KENZIE_COGNITION_ENABLED=1
KENZIE_MEMORY_RETRIEVAL_ENABLED=1
KENZIE_RESEARCH_ENABLED=0
KENZIE_BROWSER_ACTIONS_ENABLED=0
KENZIE_THINKING_VOICE=1
KENZIE_THINKING_PHRASE=Um momento senhor.
KENZIE_VOICE_RATE=175
KENZIE_VOICE_VOLUME=0.95
KENZIE_VOICE_PROFILE=TARS

# Legacy external provider settings preserved for compatibility only.
# Kenzie 0.9 does NOT initialize or call them automatically.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
